# Build artifacts
build/
*.iso
*.o
*.elf

# Limine temp files
limine.tar.xz
limine-uefi.zip

# Logs and temp files
serial.log
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
test/
tests/

# build artifacts: the ISO carries the shared object, the Makefile builds it
*.so

# The interpreter the ISO carries is copied from the build host's musl at build
# time, not vendored: keeping a 715 KB libc in the tree would tie the repository
# to one distribution's build of it.
iso_root/lib/

# Limine is downloaded and built by the Makefile (x86_64 UEFI only).
limine/

# ISO staging: rebuilt from assets/, limine/ and limine.conf on every build.
iso_root/

# Written by the Makefile on every run: a timestamp changes with each build,
# and a tracked timestamp means every build dirties the working tree.
kernel/include/buildstamp.h
